// The Windows executable's icon and version information. build.zig compiles it with
// VERSION_MAJOR, VERSION_MINOR and VERSION_PATCH from build.zig.zon.

#include <winver.h>

#define STRINGIFY_(x) #x
#define STRINGIFY(x) STRINGIFY_(x)
#define VERSION_STRING STRINGIFY(VERSION_MAJOR) "." STRINGIFY(VERSION_MINOR) "." STRINGIFY(VERSION_PATCH)

// The first icon is the one Explorer shows, and SDL's window icon.
1 ICON "../icons/harvest.ico"

1 VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Harvest port contributors"
            VALUE "FileDescription", "Harvest: Massive Encounter (port)"
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", "harvest"
            VALUE "OriginalFilename", "harvest.exe"
            VALUE "ProductName", "Harvest: Massive Encounter (port)"
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
